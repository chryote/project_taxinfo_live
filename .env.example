# Application
NODE_ENV=development
PORT=3000
FRONTEND_PORT=8080

# PostgreSQL with pgvector
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pajak_kendaraan
POSTGRES_USER=samsat_user
POSTGRES_PASSWORD=samsat_secure_pass

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=samsat_mq
RABBITMQ_PASSWORD=samsat_mq_pass
RABBITMQ_MGMT_PORT=15672

# ELK Stack (Elasticsearch & Logstash & Kibana)
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
LOGSTASH_HOST=logstash
LOGSTASH_PORT=5044
KIBANA_PORT=5601
ES_JAVA_OPTS=-Xms256m -Xmx512m

# Sustainable Computing / Green Metric Flags
ENABLE_ECO_MODE=true
MAX_CONNECTION_POOL_SIZE=10
IDLE_CONNECTION_TIMEOUT_MS=10000
