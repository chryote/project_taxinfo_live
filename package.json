{
  "name": "project_taxinfo",
  "version": "1.0.0",
  "description": "Lightweight Pajak Kendaraan Bermotor POC using ELK stack, K6, pgvector, RabbitMQ, and Vue.js",
  "author": "Fadhilah Azhar <fadhilazzhar@gmail.com>",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install --workspace=backend && npm install --workspace=frontend",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm --workspace=backend test",
    "test:frontend": "npm --workspace=frontend test",
    "build": "npm --workspace=backend run build && npm --workspace=frontend run build",
    "start:backend": "npm --workspace=backend start",
    "dev:backend": "npm --workspace=backend run dev",
    "dev:frontend": "npm --workspace=frontend run dev",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "bench:smoke": "powershell -ExecutionPolicy Bypass -File ./k6/run-benchmarks.ps1 -Scenario smoke",
    "bench:load": "powershell -ExecutionPolicy Bypass -File ./k6/run-benchmarks.ps1 -Scenario load",
    "bench:vector": "powershell -ExecutionPolicy Bypass -File ./k6/run-benchmarks.ps1 -Scenario vector",
    "bench:payment": "powershell -ExecutionPolicy Bypass -File ./k6/run-benchmarks.ps1 -Scenario payment"
  }
}
